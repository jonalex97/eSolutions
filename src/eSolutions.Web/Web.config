<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Cadena de conexión para SQL Server LocalDB (Estándar en Visual Studio) -->
    <add name="eSolutionsConn" 
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=eSolutionsPagos;Integrated Security=True;MultipleActiveResultSets=True;" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="4.5" maxRequestLength="4096" enableVersionHeader="false" />

    <!-- Configuración segura de ViewState y Sesión -->
    <pages enableViewState="true" enableViewStateMac="true" viewStateEncryptionMode="Always" />
    
    <sessionState mode="InProc" cookieless="false" timeout="30" />

    <!-- Manejo de errores controlados: Oculta detalles técnicos en entornos remotos -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx">
      <error statusCode="404" redirect="~/Error.aspx?code=404" />
      <error statusCode="500" redirect="~/Error.aspx?code=500" />
    </customErrors>
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    
    <httpProtocol>
      <customHeaders>
        <!-- Medidas de endurecimiento y seguridad HTTP -->
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <handlers>
      <add name="SimuladorEmpresasHandler" path="SimuladorEmpresas.ashx" verb="GET,HEAD" type="eSolutions.Web.SimuladorEmpresas, eSolutions.Web" resourceType="Unspecified" />
    </handlers>
    
    <defaultDocument>
      <files>
        <clear />
        <add value="Empresas.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
